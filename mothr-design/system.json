{
  "name": "Mothr",
  "description": "Quiet chrome, loud content. One violet accent for anything you can act on; agents keep their own brand tints. Dark is the primary experience.",
  "tokens": {
    "colors": {
      "bg": "#0B0C0F",
      "chrome": "#0F1014",
      "surface": "#14151A",
      "surface-hover": "#1A1B21",
      "raised": "#17181E",
      "border": "#1F2027",
      "border-strong": "#2B2C35",
      "text": "#ECECF1",
      "text-muted": "#9B9DAA",
      "text-faint": "#60626E",
      "brand": "#8B7CF6",
      "brand-hover": "#9C8FF8",
      "brand-soft": "#8B7CF624",
      "brand-2": "#4CB3FF",
      "on-brand": "#FFFFFF",
      "success": "#3DD68C",
      "warning": "#F5B544",
      "danger": "#F2555A",
      "info": "#5AA9FF",
      "claude": "#D97757",
      "codex": "#10A37F",
      "copilot": "#8B5CF6",
      "opencode": "#3B82F6",
      "hermes": "#F59E0B"
    },
    "typography": {
      "display": { "size": 34, "weight": 600, "line_height": 1.15, "family": "Geist" },
      "title": { "size": 19, "weight": 600, "line_height": 1.3, "family": "Geist" },
      "heading": { "size": 16, "weight": 600, "line_height": 1.4, "family": "Geist" },
      "read": { "size": 14.5, "weight": 400, "line_height": 1.65, "family": "Geist" },
      "body": { "size": 13.5, "weight": 400, "line_height": 1.5, "family": "Geist" },
      "label": { "size": 13.5, "weight": 500, "line_height": 1.4, "family": "Geist" },
      "caption": { "size": 11.5, "weight": 500, "line_height": 1.4, "family": "Geist" },
      "mono": { "size": 12.5, "weight": 400, "line_height": 1.55, "family": "Geist Mono" }
    },
    "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40 },
    "radii": { "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "2xl": 20, "full": 999 },
    "shadows": {
      "sm": { "x": 0, "y": 1, "blur": 2, "color": "#00000059" },
      "md": { "x": 0, "y": 8, "blur": 24, "spread": -4, "color": "#00000073" },
      "lg": { "x": 0, "y": 24, "blur": 64, "spread": -12, "color": "#00000099" },
      "glow": { "x": 0, "y": 0, "blur": 18, "color": "#8B7CF659" }
    }
  },
  "components": [
    {
      "name": "Button / Primary",
      "description": "The one thing to do next. Violet, with a soft glow.",
      "variants": [
        { "name": "Default", "node": { "type": "button", "icon": "square-pen", "text": "New chat", "style": { "bg": "$brand", "fg": "$on-brand", "radius": "$md", "padding": [9, 14], "font": "$label", "shadow": "$glow" } } },
        { "name": "Icon", "node": { "type": "button", "icon": "arrow-up", "style": { "bg": "$brand", "fg": "$on-brand", "radius": "$lg", "width": 34, "height": 34, "padding": 0, "shadow": "$glow" } } }
      ]
    },
    {
      "name": "Button / Quiet",
      "description": "Secondary actions: outlined or ghost, never filled.",
      "variants": [
        { "name": "Outline", "node": { "type": "button", "icon": "palette", "text": "New design", "style": { "bg": "transparent", "fg": "$text-muted", "radius": "$md", "padding": [8, 12], "font": "$label", "border": { "width": 1, "color": "$border-strong" } } } },
        { "name": "Ghost", "node": { "type": "button", "icon": "folder-git-2", "text": "mothr", "style": { "bg": "transparent", "fg": "$text", "radius": "$md", "padding": [6, 10], "font": "$body" } } }
      ]
    },
    {
      "name": "Pill / Status",
      "description": "Live state. Pulsing dot while an agent works or waits on you.",
      "variants": [
        { "name": "Working", "node": { "type": "row", "style": { "gap": 6, "align": "center", "padding": [3, 9], "radius": "$full", "bg": "$brand-soft" }, "children": [ { "type": "box", "style": { "width": 6, "height": 6, "radius": "$full", "bg": "$brand" } }, { "type": "text", "text": "Working", "style": { "font": "$caption", "fg": "$brand" } } ] } },
        { "name": "Needs you", "node": { "type": "row", "style": { "gap": 6, "align": "center", "padding": [3, 9], "radius": "$full", "bg": "#F5B5441A" }, "children": [ { "type": "box", "style": { "width": 6, "height": 6, "radius": "$full", "bg": "$warning" } }, { "type": "text", "text": "Needs you", "style": { "font": "$caption", "fg": "$warning" } } ] } },
        { "name": "Orchestrator", "node": { "type": "row", "style": { "gap": 4, "align": "center", "padding": [2, 7], "radius": "$full", "bg": "$brand-soft" }, "children": [ { "type": "icon", "icon": "network", "style": { "size": 11, "fg": "$brand" } }, { "type": "text", "text": "2/3", "style": { "font": "$caption", "fg": "$brand" } } ] } }
      ]
    },
    {
      "name": "Session row",
      "description": "Sidebar chat. Agent tile with status badge, title, one quiet line of context. Active rows get a violet edge.",
      "variants": [
        { "name": "Active", "node": { "type": "row", "style": { "width": 260, "gap": 10, "align": "center", "padding": [8, 10], "radius": "$md", "bg": "$surface-hover", "border": { "width": 0 } }, "children": [
          { "type": "box", "style": { "width": 26, "height": 26, "radius": 8, "bg": "#D9775729", "align": "center", "justify": "center", "border": { "width": 1, "color": "#D9775759" } }, "children": [ { "type": "icon", "icon": "sparkle", "style": { "size": 15, "fg": "$claude" } } ] },
          { "type": "column", "style": { "gap": 1, "grow": 1 }, "children": [ { "type": "text", "text": "Refactor the auth flow", "style": { "font": "$label", "fg": "$text" } }, { "type": "text", "text": "Orchestrating 2 subagents", "style": { "font": "$caption", "fg": "$brand" } } ] },
          { "type": "ref", "ref": "Pill / Status", "variant": "Orchestrator" }
        ] } }
      ]
    },
    {
      "name": "Tool card",
      "description": "Collapsed by default: what ran, where, and its outcome. Expand for output and diffs.",
      "variants": [
        { "name": "Completed", "node": { "type": "row", "style": { "width": 520, "gap": 8, "align": "center", "padding": [8, 12], "radius": "$lg", "bg": "$surface", "border": { "width": 1, "color": "$border" } }, "children": [
          { "type": "icon", "icon": "file-pen", "style": { "size": 14, "fg": "$text-muted" } },
          { "type": "text", "text": "Edit session.rs", "style": { "font": "$label", "fg": "$text" } },
          { "type": "text", "text": "crates/core/src/session.rs", "style": { "font": "$mono", "fg": "$text-faint", "grow": 1 } },
          { "type": "text", "text": "+42 −7", "style": { "font": "$caption", "fg": "$success" } },
          { "type": "icon", "icon": "check", "style": { "size": 14, "fg": "$success" } }
        ] } }
      ]
    },
    {
      "name": "Permission card",
      "description": "The agent is blocked on you. Amber frame, the exact command, and one obvious primary choice.",
      "variants": [
        { "name": "Pending", "node": { "type": "column", "style": { "width": 520, "gap": 10, "padding": 12, "radius": "$lg", "bg": "#F5B5440F", "border": { "width": 1, "color": "#F5B54480" } }, "children": [
          { "type": "row", "style": { "gap": 8, "align": "center" }, "children": [ { "type": "icon", "icon": "shield-alert", "style": { "size": 16, "fg": "$warning" } }, { "type": "text", "text": "Permission needed", "style": { "font": "$label", "fg": "$text" } }, { "type": "text", "text": "Run command", "style": { "font": "$body", "fg": "$text-muted" } } ] },
          { "type": "box", "style": { "padding": 8, "radius": "$md", "bg": "$bg", "border": { "width": 1, "color": "$border" } }, "children": [ { "type": "text", "text": "cargo test --workspace", "style": { "font": "$mono", "fg": "$text" } } ] },
          { "type": "row", "style": { "gap": 8 }, "children": [
            { "type": "button", "text": "Allow", "style": { "bg": "$brand", "fg": "$on-brand", "radius": "$md", "padding": [6, 12], "font": "$label" } },
            { "type": "button", "text": "Always allow", "style": { "bg": "transparent", "fg": "$text", "radius": "$md", "padding": [6, 12], "font": "$label", "border": { "width": 1, "color": "$border-strong" } } },
            { "type": "button", "text": "Deny", "style": { "bg": "transparent", "fg": "$text-muted", "radius": "$md", "padding": [6, 12], "font": "$label" } }
          ] }
        ] } }
      ]
    },
    {
      "name": "Composer",
      "description": "Where every chat starts. Raised surface; the border turns violet and glows on focus.",
      "variants": [
        { "name": "Focused", "node": { "type": "column", "style": { "width": 560, "gap": 10, "padding": [14, 14, 10, 18], "radius": "$xl", "bg": "$surface", "border": { "width": 1, "color": "#8B7CF68C" }, "shadow": "$glow" }, "children": [
          { "type": "text", "text": "Describe what you want to build, fix or explore…", "style": { "font": "$read", "fg": "$text-faint" } },
          { "type": "row", "style": { "gap": 6, "align": "center" }, "children": [
            { "type": "ref", "ref": "Button / Quiet", "variant": "Ghost", "overrides": { "text": "Claude Code" } },
            { "type": "ref", "ref": "Button / Quiet", "variant": "Ghost" },
            { "type": "spacer" },
            { "type": "ref", "ref": "Button / Primary", "variant": "Icon" }
          ] }
        ] } }
      ]
    }
  ]
}
