# R8 rules for the release APK.

# JNA binds native code by class, method and field names, so none of it may be renamed or
# removed. It also references desktop-only AWT classes that don't exist on Android.
-keep class com.sun.jna.** { *; }
-keep class * implements com.sun.jna.** { *; }
-dontwarn java.awt.**

# The UniFFI bindings to the Rust client (generated by Gobley): JNA looks up their native
# functions, structures and callbacks by name.
-keep class dev.mothr.client.** { *; }
